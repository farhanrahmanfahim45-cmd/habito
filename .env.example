# Habito environment
# Copy to .env.local and fill in. Never commit the filled-in file.

# Supabase project settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# The anon key is safe in the browser: it is a public key, and every table is
# protected by row-level security. The service_role key must NEVER appear here
# or anywhere in this repository — it bypasses every policy.
